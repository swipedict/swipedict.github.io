<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 800" width="400" height="800">
  <defs>
    <linearGradient id="mockupGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#6366f1;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#312e81;stop-opacity:1" />
    </linearGradient>
  </defs>
  <!-- Phone frame -->
  <rect x="10" y="10" width="380" height="780" rx="40" fill="#1e293b" stroke="#cbd5e1" stroke-width="3"/>
  <!-- Screen -->
  <rect x="25" y="60" width="350" height="700" rx="15" fill="url(#mockupGrad)"/>
  <!-- App content mockup -->
  <rect x="50" y="100" width="300" height="80" rx="10" fill="white" opacity="0.9"/>
  <text x="200" y="145" font-family="Arial" font-size="20" font-weight="bold" fill="#312e81" text-anchor="middle">SwipeDict</text>
  
  <rect x="50" y="220" width="300" height="150" rx="10" fill="white" opacity="0.8"/>
  <text x="200" y="260" font-family="Arial" font-size="16" fill="#1e293b" text-anchor="middle">Word Card</text>
  <text x="200" y="300" font-family="Arial" font-size="24" font-weight="bold" fill="#312e81" text-anchor="middle">casa</text>
  <text x="200" y="330" font-family="Arial" font-size="18" fill="#475569" text-anchor="middle">house</text>
  
  <!-- Swipe indicator -->
  <path d="M 80 700 L 120 700 L 110 690 M 120 700 L 110 710" stroke="white" stroke-width="3" fill="none" opacity="0.6"/>
  <path d="M 320 700 L 280 700 L 290 690 M 280 700 L 290 710" stroke="white" stroke-width="3" fill="none" opacity="0.6"/>
</svg>